# ShellCheck configuration for Caelestia
# https://www.shellcheck.net/wiki/

# check_shell_quality.sh reports at warning severity and above, so the style-level
# suggestions these turn on only surface when running shellcheck by hand.
enable=all

# Paths to source (for source= directives)
source-path=SCRIPTDIR

# Disabled rules:
#
# SC1090 - can't follow non-constant source (we source dynamic files)
# SC1091 - not following external file (sourced from BUNDLE_DIR etc.)
# SC2034 - unused variable (false positives across scripts)
# SC2154 - referenced but not assigned (env vars set by the installer)
# SC2155 - declare and assign separately (style)
# SC2250 - braces around variable references (style)
#
# SC2164 (cd without || exit) is deliberately NOT disabled: uninstall.sh, update.sh and
# installer/distro/* run without `set -e`, where an unguarded cd silently retargets
# everything after it.

disable=SC1090,SC1091,SC2034,SC2154,SC2155,SC2250

# Extended analysis
extended-analysis=true
