# Maintainer: ladybug-me <rajveer2027singh@gmail.com>

pkgname=caelestia-kde
pkgver=2.5.0
pkgrel=1
pkgdesc='The Caelestia desktop shell, ported to KDE Plasma'
arch=('x86_64' 'aarch64')
url='https://github.com/ladybug-me/caelestia-kde'
license=('GPL-3.0-or-later')
depends=(
    'bash'
    'quickshell'
    'matugen'
    'python'
    'git'
    'plasma-workspace'
    'qt6-base'
    'qt6-declarative'
    'qt6-multimedia'
    'qt6-5compat'
    'qt6-imageformats'
    'qt6-svg'
    'qt6-wayland'
    'kwindowsystem'
    'kguiaddons'
    'networkmanager-qt'
    'pulseaudio-qt'
    'kglobalaccel'
    'kconfig'
    'kcoreaddons'
    'libqalculate'
    'libpipewire'
    'aubio'
    'libcava'
    'cava'
    'libx11'
    'wayland'
    'ddcutil'
    'brightnessctl'
    'networkmanager'
    'power-profiles-daemon'
    'ttf-material-symbols-variable'
)
makedepends=('cmake' 'ninja' 'qt6-shadertools' 'extra-cmake-modules' 'kwin' 'vulkan-headers')
optdepends=(
    'ttf-rubik-vf: clock and workspace font'
    'ttf-cascadia-code-nerd: monospace font'
    'konsole: the terminal scheme is written into it and its profiles follow it'
    'spectacle: screenshots'
    'swappy: screenshot editing'
    'gpu-screen-recorder: screen recording'
    'howdy: face unlock'
    'fprintd: fingerprint unlock'
    'asdbctl: Apple Studio Display brightness'
)
provides=('caelestia-shell')
conflicts=('caelestia-shell' 'caelestia-shell-git')

# The source tarball is published by the release workflow as v$pkgver, so pkgver
# must match .github/version.env (currently v2.5.0) - keeping them in sync is what
# stops a packaged install from reporting an update on day one.
#
# _source_sum defaults to SKIP so local builds work before a release publishes the
# tarball: makepkg will not verify the main source. Do not invent a checksum. To fill
# it in, either take the sha256 of the exact release tarball:
#   curl -sL "$_source_url" | sha256sum
# or run packaging/aur/makepkg-from-checkout.sh, which reproduces the tarball from a
# checkout (submodules inlined, fonts excluded, REVISION written), hashes it, and
# prints/injects both _source_url and _source_sum for a verified local build.
_source_url="${_source_url:-$url/releases/download/v$pkgver/$pkgname-v$pkgver.tar.gz}"
_source_sum="${_source_sum:-SKIP}"

source=("$_source_url"
        'caelestia-autostart'
        'caelestia-shell.service')
sha256sums=("$_source_sum"
            '378569eb38a781d827570afdd08a8452dfcf36caabd373642080482918c151c6'
            'f219b72c98ad98418cbe9ef2648d0c2cd3664d36bd06f2870b8c8b253d6d17c8')

prepare() {
    cd "$srcdir/$pkgname-$pkgver"

    local sub
    for sub in src/dots src/yet-another-monochrome-icon-set; do
        if [[ -z "$(ls -A "$sub" 2>/dev/null)" ]]; then
            echo "submodule $sub is empty in the source tarball" >&2
            return 1
        fi
    done
}

build() {
    cd "$srcdir/$pkgname-$pkgver"
    cmake -B build -S shell -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_INSTALL_PREFIX=/ \
        -DVERSION="$pkgver" \
        -DREQUIRE_CAVA=ON \
        -DDISTRIBUTOR="AUR (package: $pkgname)"
    cmake --build build || exit 1

    cmake -B effect-build -S shell/kwin-effects/workspace-tracker -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build effect-build || exit 1
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    DESTDIR="$pkgdir" cmake --install build
    DESTDIR="$pkgdir" cmake --install effect-build

    # The Plasma visualiser applet ships as plain package files: the packaged
    # install path never runs 08-build-shell.sh's plasmoid step, so the applet
    # must land in the system plasmoids dir from here.
    install -d "$pkgdir/usr/share/plasma/plasmoids"
    cp -r src/kde/plasmoids/org.caelestia.visualiser \
        "$pkgdir/usr/share/plasma/plasmoids/"

    rm -rf "$pkgdir/etc/xdg/quickshell/caelestia/assets/fonts"

    install -d "$pkgdir/usr/share/caelestia"
    install -d "$pkgdir/usr/share/caelestia/scripts"
    install -m755 scripts/[0-9]*.sh "$pkgdir/usr/share/caelestia/scripts/"
    cp -r scripts/lib "$pkgdir/usr/share/caelestia/scripts/"
    install -d "$pkgdir/usr/share/caelestia/src" "$pkgdir/usr/share/caelestia/assets" \
        "$pkgdir/usr/share/caelestia/shell/assets"
    cp -r src/dots src/dots-extra "$pkgdir/usr/share/caelestia/src/"
    cp -r shell/assets/wallpapers "$pkgdir/usr/share/caelestia/shell/assets/"
    cp -r assets/org.quickshell.desktop "$pkgdir/usr/share/caelestia/assets/"
    install -d "$pkgdir/usr/share/sddm/themes/caelestia/scripts"
    cp -r src/sddm/themes/full/* "$pkgdir/usr/share/sddm/themes/caelestia/"
    install -m755 src/sddm/sync.sh "$pkgdir/usr/share/sddm/themes/caelestia/scripts/sync.sh"
    install -Dm644 src/kde/shells/caelestia.desktop/contents/fonts/GoogleSansFlex.ttf \
        "$pkgdir/usr/share/sddm/themes/caelestia/assets/google-sans-flex/GoogleSansFlex.ttf"
    install -d "$pkgdir/etc/sddm.conf.d"
    cat > "$pkgdir/etc/sddm.conf.d/zz-caelestia.conf" <<'DROPIN'
[General]
GreeterEnvironment=QML_XHR_ALLOW_FILE_READ=1

[Theme]
Current=caelestia
DROPIN

    install -d "$pkgdir/usr/lib/udev/rules.d"
    echo 'KERNEL=="uinput", MODE="0600", OPTIONS+="static_node=uinput", TAG+="uaccess"' > "$pkgdir/usr/lib/udev/rules.d/70-uinput.rules"

    install -d "$pkgdir/etc/xdg/quickshell/caelestia/assets/icons"
    cp -r src/yet-another-monochrome-icon-set \
        "$pkgdir/etc/xdg/quickshell/caelestia/assets/icons/"

    install -d "$pkgdir/usr/bin"
    install -m755 src/bin/* "$pkgdir/usr/bin/"

    install -d "$pkgdir/usr/share/caelestia"
    cp -r src/matugen src/schemes "$pkgdir/usr/share/caelestia/"

    install -d "$pkgdir/usr/share/plasma/shells"
    cp -r src/kde/shells/caelestia.desktop "$pkgdir/usr/share/plasma/shells/"

    install -Dm755 "$srcdir/caelestia-autostart" "$pkgdir/usr/bin/caelestia-autostart"
    install -Dm644 "$srcdir/caelestia-shell.service" \
        "$pkgdir/usr/lib/systemd/user/caelestia-shell.service"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    find "$pkgdir" \( -name '.git' -o -name '.github' -o -name '.gitignore' \) \
        -prune -exec rm -rf {} + 2>/dev/null || true

    local required=(
        usr/bin/caelestia
        usr/share/caelestia/scripts/03-deploy-configs.sh
        usr/share/caelestia/scripts/lib/install-kind.sh
        usr/share/caelestia/src/dots
        usr/share/caelestia/src/dots-extra
        usr/share/caelestia/shell/assets/wallpapers
        usr/share/caelestia/assets/org.quickshell.desktop
        usr/share/sddm/themes/caelestia/theme.conf
        usr/share/sddm/themes/caelestia/scripts/sync.sh
        etc/sddm.conf.d/zz-caelestia.conf
        usr/lib/systemd/user/caelestia-shell.service
        etc/xdg/quickshell/caelestia/assets/icons/yet-another-monochrome-icon-set
    )
    local path
    for path in "${required[@]}"; do
        if [[ ! -e "$pkgdir/$path" ]]; then
            echo "missing from the package: $path" >&2
            exit 1
        fi
    done

    if [[ -e "$pkgdir/etc/xdg/quickshell/caelestia/assets/fonts" ]]; then
        echo "the fonts are in the package again: 12-fetch-assets.sh downloads them instead" >&2
        exit 1
    fi

    echo "package layout checked: ${#required[@]} paths"
}
