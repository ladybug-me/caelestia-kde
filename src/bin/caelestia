#!/usr/bin/env bash

set -euo pipefail

SELF="$(realpath -- "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
BIN_DIR="${CAELESTIA_BIN_DIR:-$(dirname -- "$SELF")}"
SELF_DIR="$(dirname -- "$SELF")"

VERSION_FILE=""
CHECKOUT="${CAELESTIA_DIR:-}"
case "${CAELESTIA_INSTALL_KIND:-$( [[ "$BIN_DIR" == /usr/bin ]] && printf 'package' || printf 'source' )}" in
    package)
        KIND=package
        DATA_DIR="${CAELESTIA_DATA_DIR:-/usr/share/caelestia}"
        QML_IMPORT_DEFAULT="/usr/lib/qt6/qml:/etc/xdg/quickshell/caelestia"
        LIB_DIR_DEFAULT=/usr/lib/caelestia
        SHELL_CONFIG_DEFAULT=/etc/xdg/quickshell/caelestia/shell.qml
        ;;
    *)
        KIND=source
        [[ -n "$CHECKOUT" ]] || CHECKOUT="$HOME/caelestia-kde"
        DATA_DIR="${CAELESTIA_DATA_DIR:-$CHECKOUT}"
        QML_IMPORT_DEFAULT="$HOME/.local/lib/qt6/qml:$HOME/.config/quickshell/caelestia"
        LIB_DIR_DEFAULT="$HOME/.local/lib/caelestia"
        SHELL_CONFIG_DEFAULT="$HOME/.config/quickshell/caelestia/shell.qml"
        VERSION_FILE="$SELF_DIR/../../.github/version.env"
        [[ -f "$VERSION_FILE" ]] || VERSION_FILE="$CHECKOUT/.github/version.env"
        ;;
esac
SCRIPTS_DIR="$DATA_DIR/scripts"

export QML2_IMPORT_PATH="$QML_IMPORT_DEFAULT${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
export CAELESTIA_LIB_DIR="${CAELESTIA_LIB_DIR:-$LIB_DIR_DEFAULT}"
export CAELESTIA_SHELL_CONFIG="${CAELESTIA_SHELL_CONFIG:-$SHELL_CONFIG_DEFAULT}"

helper() {
    local name="$1"
    shift
    local path="$BIN_DIR/$name"
    if [[ ! -x "$path" ]]; then
        printf '[ERR] %s is missing or not executable: %s\n' "$name" "$path" >&2
        exit 127
    fi
    exec "$path" "$@"
}

usage() {
    cat <<'EOF'
caelestia - control the Caelestia shell

Usage: caelestia <command> [args...]

Commands
  shell [OPTS] [MESSAGE...]    start the shell, or message the running one
  install                      set up this user's half of the shell
  update [REF]                 update the shell and re-apply the configuration
  login-screen                 configure the login screen for the display manager in use
  wallpaper [OPTS]             set the wallpaper and derive the palette from it
  scheme <list|get|set> [...]  manage the color scheme
  screenshot [OPTS]            take a screenshot
  record [OPTS]                record the screen
  version                      print the version
  help                         print this message

Shell options
  -d, --daemon    start the shell detached
  -r, --restart   restart the shell
  -s, --show      list the shell IPC commands
  -l, --log       print the shell log
  -k, --kill      stop the shell

Screenshot options
  -r, --region    capture a region instead of the whole screen

Run 'caelestia <command> -h' for the options of a command.
EOF
}

shell_usage() {
    cat <<'EOF'
Usage: caelestia shell [OPTS] [MESSAGE...]

With no MESSAGE the shell is started. With a MESSAGE, that IPC command is sent
to the running shell, for example: caelestia shell nexus openPage 0 8

Options
  -d, --daemon    start the shell detached. The shell always runs under systemd
                  on KDE, so this is accepted for parity and changes nothing
  -r, --restart   restart the shell
  -s, --show      list the shell IPC commands
  -l, --log       print the shell log
  -k, --kill      stop the shell
EOF
}

cmd_shell() {
    local restart=0 show=0 log=0 stop=0
    local -a message=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d|--daemon)
                shift
                ;;
            -r|--restart)
                restart=1
                shift
                ;;
            -s|--show)
                show=1
                shift
                ;;
            -l|--log)
                log=1
                shift
                ;;
            -k|--kill)
                stop=1
                shift
                ;;
            -h|--help)
                shell_usage
                return 0
                ;;
            --)
                shift
                message+=("$@")
                break
                ;;
            -*)
                printf '[ERR] unknown option for shell: %s\n' "$1" >&2
                return 2
                ;;
            *)
                message+=("$1")
                shift
                ;;
        esac
    done

    if ((stop)); then
        helper caelestia-shell-ipc quit
    fi
    if ((restart)); then
        helper caelestia-shell-ipc restart
    fi
    if ((show)); then
        helper caelestia-shell-ipc show
    fi
    if ((log)); then
        helper caelestia-shell-ipc log
    fi
    if ((${#message[@]} > 0)); then
        helper caelestia-shell-ipc call "${message[@]}"
    fi

    helper caelestia-shell-ipc start
}

screenshot_usage() {
    cat <<'EOF'
Usage: caelestia screenshot [OPTS]

Options
  -r, --region    capture a region instead of the whole screen

Also accepted by the helper: --save PATH, --open.
EOF
}

cmd_screenshot() {
    local -a args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -r|--region)
                args+=(region)
                shift
                ;;
            -f|--freeze)
                printf '[WARN] screenshot: --freeze has no equivalent here; ignoring\n' >&2
                shift
                ;;
            -h|--help)
                screenshot_usage
                return 0
                ;;
            -*)
                printf '[ERR] unknown option for screenshot: %s\n' "$1" >&2
                return 2
                ;;
            *)
                args+=("$1")
                shift
                ;;
        esac
    done

    if ((${#args[@]} == 0)); then
        args+=(full)
    fi
    helper caelestia-screenshot "${args[@]}"
}

has_installer() {
    [[ -f "$SCRIPTS_DIR/lib/installer-bin.sh" ]]
}

packaged_install() {
    if ! has_installer; then
        cat >&2 <<EOF
[ERR] no installer scripts found in $SCRIPTS_DIR

  A package keeps them in /usr/share/caelestia and runs this command from its own
  copy. Reinstall the package, or set CAELESTIA_DATA_DIR to where they are.
EOF
        return 1
    fi

    if [[ "$KIND" != package ]]; then
        printf '[ERR] %s is a checkout, not a package install.\n\n  Run its installer instead: bash %s/install.sh\n' "$DATA_DIR" "$DATA_DIR" >&2
        return 1
    fi

    local -a steps=(
        03-deploy-configs
        03a-wallpapers
        04-deploy-kde
        04a-window-rules
        05-sddm-theme
        06-services
        08-build-shell
        09-system-tweaks
        10-autostart
    )

    # shellcheck source=/dev/null
    . "$SCRIPTS_DIR/lib/installer-bin.sh"

    export CAELESTIA_FRESH_INSTALL="${CAELESTIA_FRESH_INSTALL:-1}"

    echo "Deploying the user's half of a packaged Caelestia install"
    echo "  steps: $SCRIPTS_DIR"
    echo

    for id in "${steps[@]}"; do
        printf '== %s\n' "$id"
        local status=0
        BUNDLE_DIR="$DATA_DIR" CAELESTIA_INSTALL_KIND="$KIND" caelestia_run_step "$id" || status=$?
        if [[ "$status" -ne 0 ]]; then
            printf '[ERR] %s failed; nothing after it was run.\n' "$id" >&2
            return 1
        fi
        echo
    done

    echo "PROGRESS: done: User configuration applied"
    echo "The shell starts at your next login. To start it now:"
    echo "  systemctl --user start caelestia-shell.service"
}

cmd_install() {
    case "${1:-}" in
        -h|--help)
            cat <<'EOF'
Usage: caelestia install

Set up this user's half of the shell, idempotently: the configuration files, the
KDE settings, the user services, the environment and the autostart state. Run it
after installing the package, and again after each update.

A checkout is installed through its own installer, which does the machine's half
as well: set CAELESTIA_DIR to point at one other than ~/caelestia-kde.
EOF
            return 0
            ;;
    esac
    if [[ $# -gt 0 ]]; then
        printf '[ERR] unknown option for install: %s\n' "$1" >&2
        return 2
    fi

    if [[ -n "$CHECKOUT" && -f "$CHECKOUT/install.sh" ]]; then
        exec sh "$CHECKOUT/install.sh"
    fi

    packaged_install
}

cmd_login_screen() {
    case "${1:-}" in
        -h|--help)
            cat <<'EOF'
Usage: caelestia login-screen

Configure the login screen for the display manager this machine boots. Run it after
switching between Plasma Login and SDDM: the installer configures the manager that
was live when it ran.

The theme is installed in the variant that is already there, so an install made with
SDDM_THEME_VARIANT=mini keeps the mini theme.
EOF
            return 0
            ;;
    esac
    if [[ $# -gt 0 ]]; then
        printf '[ERR] unknown option for login-screen: %s\n' "$1" >&2
        return 2
    fi

    if [[ ! -f "$SCRIPTS_DIR/lib/installer-bin.sh" ]]; then
        printf '[ERR] no installer scripts found in %s\n\n' "$SCRIPTS_DIR" >&2
        printf '      A package keeps them in /usr/share/caelestia and runs this command\n' >&2
        printf '      from its own copy. Reinstall the package, or set CAELESTIA_DATA_DIR to\n' >&2
        printf '      where they are.\n' >&2
        return 1
    fi

    # shellcheck source=/dev/null
    . "$SCRIPTS_DIR/lib/installer-bin.sh"

    BUNDLE_DIR="$DATA_DIR" CAELESTIA_INSTALL_KIND="$KIND" INSTALL_SDDM=true \
        caelestia_run_step 05-sddm-theme
}

cmd_version() {
    local version=""
    if [[ -x "$CAELESTIA_LIB_DIR/version" ]]; then
        version="$("$CAELESTIA_LIB_DIR/version" -s 2>/dev/null | awk '{ sub(/,/, "", $2); print $2 }')"
    fi
    if [[ -z "$version" && -f "$VERSION_FILE" ]]; then
        version="$(awk -F= '$1 == "VERSION" { print $2; exit }' "$VERSION_FILE")"
    fi
    if [[ -n "$version" && "$version" != v* ]]; then
        version="v$version"
    fi

    printf 'caelestia %s\n' "${version:-unknown}"
}

main() {
    local command="${1:-}"
    if [[ -z "$command" ]]; then
        usage
        return 0
    fi
    shift

    case "$command" in
        shell)
            cmd_shell "$@"
            ;;
        install)
            cmd_install "$@"
            ;;
        update)
            helper caelestia-update "$@"
            ;;
        login-screen)
            cmd_login_screen "$@"
            ;;
        wallpaper|scheme)
            helper caelestia-color "$command" "$@"
            ;;
        screenshot)
            cmd_screenshot "$@"
            ;;
        record)
            helper caelestia-record "$@"
            ;;
        version|--version|-v)
            cmd_version
            ;;
        help|--help|-h)
            usage
            ;;
        *)
            printf '[ERR] unknown command: %s\n\n' "$command" >&2
            usage >&2
            return 2
            ;;
    esac
}

main "$@"
