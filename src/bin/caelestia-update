#!/usr/bin/env bash
export PATH="$HOME/.local/bin:$PATH"

set -uo pipefail

die()  { echo "[FATAL] $*" >&2; exit 1; }
info() { echo "[INFO]  $*"; }
ok()   { echo "[OK]    $*"; }
warn() { echo "[WARN]  $*"; }

run_stage() {
    local timeout_seconds="$1"
    shift

    if command -v timeout >/dev/null 2>&1; then
        timeout --foreground "$timeout_seconds" "$@"
    else
        "$@"
    fi
}

usage() {
    cat << 'EOF'
Usage: caelestia-update [--takeover] [branch] [tag|commit]

Updates the shell from its own repository clone and redeploys it. The branch
defaults to the channel recorded by the last update
(~/.config/quickshell/caelestia/.update_branch), or "main" when nothing is
recorded; both update paths share that default.

--takeover   Re-own the update state even if the checkout-based updater
             (update.sh / the installer TUI) owns it. Without this flag this
             script refuses to clobber state naming a still-live checkout,
             because the two mechanisms deploy from different checkouts and
             would otherwise rewind each other (issue #565).

Forks: the clone tracks CAELESTIA_REPO_OWNER/caelestia-kde (default
ladybug-me); see README.md, "For forks".
EOF
}

# Fork identity: the owner of the git repositories cloned/pulled for source
# and updates. Upstream default stays ladybug-me; a fork exports its own user.
: "${CAELESTIA_REPO_OWNER:=ladybug-me}"
REPO_URL="https://github.com/${CAELESTIA_REPO_OWNER}/caelestia-kde.git"

# Positional arguments are the branch and an optional tag/commit target; the
# one flag this updater takes is the #565 ownership override.
TAKEOVER=0
BRANCH_ARG=""
TARGET_ARG=""
for arg in "$@"; do
    case "$arg" in
        --takeover)
            TAKEOVER=1
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            if [ -z "$BRANCH_ARG" ]; then
                BRANCH_ARG="$arg"
            elif [ -z "$TARGET_ARG" ]; then
                TARGET_ARG="$arg"
            else
                die "Unexpected argument: $arg (see --help)"
            fi
            ;;
    esac
done

BRANCH="$BRANCH_ARG"
if [ -z "$BRANCH" ]; then
    # Same default order as update.sh: the recorded channel, then "main".
    BRANCH="$(head -n1 "$HOME/.config/quickshell/caelestia/.update_branch" 2>/dev/null || true)"
    if [ -n "$BRANCH" ]; then
        echo "[INFO]  Using the recorded update channel: $BRANCH"
    else
        BRANCH="main"
    fi
fi
if [ "$BRANCH" != "main" ] && [ "$BRANCH" != "dev" ]; then
    echo "Warning: Branch '$BRANCH' is not allowed. Falling back to 'main'."
    BRANCH="main"
fi
if ! git ls-remote --exit-code --heads "$REPO_URL" "$BRANCH" >/dev/null 2>&1; then
    echo "Warning: Branch '$BRANCH' does not exist on remote. Falling back to 'main'."
    BRANCH="main"
fi
TARGET_REF="$TARGET_ARG"
if [ -n "$TARGET_REF" ]; then
    if git ls-remote --exit-code --tags "$REPO_URL" "$TARGET_REF" >/dev/null 2>&1; then
        TARGET_KIND="tag"
    elif [ "$BRANCH" = "dev" ] && [[ "$TARGET_REF" =~ ^[0-9a-f]{7,40}$ ]]; then
        # Dev can also install or revert to a specific commit, not just a tag.
        TARGET_KIND="commit"
    else
        echo "Warning: Version tag '$TARGET_REF' not found on remote. Ignoring target and using branch head."
        TARGET_REF=""
    fi
fi
UPD_DIR="$HOME/.config/caelestia-update"

# Prevent concurrent update runs from racing on git/CMake/config writes.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/caelestia-update.lock"
flock -n 9 || { echo "Another Caelestia update is already running."; exit 1; }

echo "---------------------------------------------"
if [ -n "$TARGET_REF" ]; then
    echo "  Caelestia Update (Branch: $BRANCH, Target: $TARGET_REF)"
else
    echo "  Caelestia Update (Branch: $BRANCH)"
fi
echo "---------------------------------------------"

# Which half owns this install: /usr/bin is a package, anything else a checkout. Nothing
# is probed on disk, so it stays right whatever the package is called.
SELF_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
PACKAGED=0
case "$SELF_DIR" in
    /usr/bin) PACKAGED=1 ;;
esac

# A package install needs none of these; its branch below hands off to the package manager.
if [ "$PACKAGED" -eq 0 ]; then
    for cmd in git cmake make; do
        if ! command -v "$cmd" &> /dev/null; then
            die "Required command '$cmd' is missing. Please install it first."
        fi
    done
fi

# sudo wrapper: cached credentials first, interactive prompt only when expired.
mkdir -p "$UPD_DIR/bin"
cat << 'EOF' > "$UPD_DIR/bin/sudo"
#!/usr/bin/env bash
if [ "$EUID" -eq 0 ]; then
    exec "$@"
fi
# -n first: if the parent keepalive kept the timestamp fresh, no prompt at all.
if /usr/bin/sudo -n true 2>/dev/null; then
    exec /usr/bin/sudo -n "$@"
fi
# Expired or never created: whichever interactive helper exists.
if [ -t 1 ]; then
    exec /usr/bin/sudo "$@"
elif command -v ksshaskpass &> /dev/null; then
    exec env SUDO_ASKPASS="$(command -v ksshaskpass)" /usr/bin/sudo -A "$@"
elif command -v pkexec &> /dev/null; then
    exec pkexec "$@"
else
    echo "Cannot elevate privileges. Please install ksshaskpass, pkexec, or run from a terminal." >&2
    exit 1
fi
EOF
chmod +x "$UPD_DIR/bin/sudo"
export PATH="$UPD_DIR/bin:$PATH"

# Package-managed install.
#
# A package owns what it installed, so the update is the package manager, not the clone
# and second build below: two shells with only one known to pacman breaks in ways nobody
# can explain a year later, and needs a toolchain the package does not.
if [ "$PACKAGED" -eq 1 ]; then
    echo "---------------------------------------------"
    echo "  Caelestia Update (this install came from a package)"
    echo "---------------------------------------------"
    echo
    # $1 is the branch, $2 the version: only the latter means "a version was asked for".
    if [ -n "${TARGET_REF:-}" ]; then
        echo "  A single version cannot be selected from here; choose it where the"
        echo "  package was installed from."
        echo
    fi
    if command -v pacman &> /dev/null; then
        info "Updating the system packages..."
        sudo pacman -Syu --noconfirm || warn "The package update failed or was cancelled."
    else
        warn "No pacman found; update this package with the tool that installed it."
    fi
    info "And the shell itself:"
    echo "    pacman:  sudo pacman -Syu caelestia-kde"
    echo "    AUR:     rebuild caelestia-kde with the helper it was installed with"
    echo

    # All this can do is the user's half: the package's step scripts are its own copies, and
    # `caelestia install` deploys from them idempotently (parity-6).
    if [[ -x "$SELF_DIR/caelestia" ]]; then
        info "Re-applying the user's configuration..."
        "$SELF_DIR/caelestia" install || warn "Applying the user's configuration failed; see the output above."
    fi

    echo "    then log out and back in."
    echo "PROGRESS: done: Package update finished"
    exit 0
fi

# Ownership guard (#565), before anything is fetched or deployed: when the
# state names the checkout-based updater (update.sh / installer TUI) and that
# checkout still exists, rewriting the state from this shadow clone would
# rewind the recorded revision the checkout-based install depends on. This
# mirrors update_state_allow_takeover in scripts/lib/update-state.sh; this
# script ships standalone in ~/.local/bin, so it cannot source the lib before
# its own clone exists. Packaged installs exited above: they never touch the
# state, so the guard does not apply to them.
STATE_CONFIG="$HOME/.config/quickshell/caelestia"
if [ "$TAKEOVER" -ne 1 ]; then
    STATE_OWNER="$(head -n1 "$STATE_CONFIG/.update_source" 2>/dev/null || true)"
    if [ "$STATE_OWNER" = "tui" ]; then
        STATE_REPO="$(head -n1 "$STATE_CONFIG/.update_repo" 2>/dev/null || true)"
        if [ -z "$STATE_REPO" ] || git -C "$STATE_REPO" rev-parse --git-dir >/dev/null 2>&1; then
            die "This install is managed by the checkout-based updater (update.sh / installer TUI)${STATE_REPO:+ at $STATE_REPO}.
Run 'bash ${STATE_REPO:-<your caelestia-kde checkout>}/update.sh' there, or re-run with --takeover to let the CLI updater take over."
        fi
        echo "[INFO]  The checkout that owned this install is gone; taking over the update state."
    fi
fi

# Primes escalation once and refreshes it in the background, so the root work below never
# prompts again, even after a long build.
if [ "$EUID" -ne 0 ]; then
    # Determine the best interactive helper for the initial prompt.
    if [ -t 1 ]; then
        SUDO_ASK_CMD=(/usr/bin/sudo -v)
    elif command -v ksshaskpass &> /dev/null; then
        SUDO_ASK_CMD=(env SUDO_ASKPASS="$(command -v ksshaskpass)" /usr/bin/sudo -A -v)
    elif command -v pkexec &> /dev/null; then
        # pkexec authorizes through PolicyKit, not sudo's timestamp cache, so there is nothing to
        # prime: each elevation goes through pkexec, which does its own caching.
        info "Requesting administrator privileges via pkexec (PolicyKit)..."
        pkexec true || die "Failed to obtain administrator privileges."
        SUDO_ASK_CMD=()  # Skip the keepalive below: no sudo timestamp exists.
    else
        die "Cannot elevate privileges — no terminal, ksshaskpass, or pkexec available."
    fi

    if [[ ${#SUDO_ASK_CMD[@]} -gt 0 ]]; then
        info "Requesting administrator privileges (used for system update and installing the shell)..."
        "${SUDO_ASK_CMD[@]}" || die "Failed to obtain administrator privileges."
    fi

    # So sub-scripts using raw `/usr/bin/sudo -A` do not have to rediscover it.
    if command -v ksshaskpass &> /dev/null; then
        export SUDO_ASKPASS="$(command -v ksshaskpass)"
    fi

    # Keeps the sudo timestamp alive through long builds (-nv extends it, not just checks).
    # Runs only when a timestamp exists; pkexec does its own caching.
    if [[ ${#SUDO_ASK_CMD[@]} -gt 0 ]]; then
        (
            while kill -0 "$$" 2>/dev/null; do
                sleep 30
                sudo -nv 2>/dev/null || true
            done
        ) &
        SUDO_KEEPALIVE_PID=$!
        trap '[ -n "${SUDO_KEEPALIVE_PID:-}" ] && kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true' EXIT
    fi
fi

# 1. Fetch from GitHub
echo "PROGRESS: 1/5: Fetching updates from GitHub..."
info "Checking for local repository cache..."

export BACKUP_DIR="$UPD_DIR/backups/$(date +%Y%m%d_%H%M%S)"
mkdir -p "$BACKUP_DIR"

if [[ ! -d "$UPD_DIR/repo/.git" ]]; then
    mkdir -p "$UPD_DIR/repo"
    cd "$UPD_DIR/repo" || die "Failed to enter $UPD_DIR/repo"
    git init -q
    git remote add origin "$REPO_URL"
else
    cd "$UPD_DIR/repo" || die "Failed to enter $UPD_DIR/repo"
    if git rev-parse HEAD >/dev/null 2>&1; then
        git reset --hard -q HEAD || die "Failed to reset repository state"
    fi
    git clean -fdx -q
    git remote set-url origin "$REPO_URL"
fi

# Always enforce sparse-checkout rules
git config core.sparseCheckout true
echo "shell/" > .git/info/sparse-checkout
echo "src/" >> .git/info/sparse-checkout
echo "scripts/" >> .git/info/sparse-checkout
echo "installer/" >> .git/info/sparse-checkout
echo ".github/version.env" >> .git/info/sparse-checkout
echo ".gitmodules" >> .git/info/sparse-checkout

# Safer fetch and reset instead of pull
if [ -n "$TARGET_REF" ] && [ "${TARGET_KIND:-}" = "commit" ]; then
    # The clone is normally depth 1; fetch enough history for the timeline the UI shows
    # (UpdateChecker: up to 150 commits) rather than unshallowing.
    git fetch -q --depth=200 origin "$BRANCH" || die "Failed to fetch repository"
    if git cat-file -e "$TARGET_REF^{commit}" 2>/dev/null; then
        git reset --hard -q "$TARGET_REF" || die "Failed to apply commit $TARGET_REF"
    else
        warn "Commit '$TARGET_REF' not found on '$BRANCH'; falling back to branch head."
        git reset --hard -q origin/"$BRANCH" || die "Failed to apply updates"
    fi
elif [ -n "$TARGET_REF" ]; then
    git fetch -q --depth 1 origin "refs/tags/$TARGET_REF:refs/tags/$TARGET_REF" || die "Failed to fetch version tag"
    git reset --hard -q "$TARGET_REF" || die "Failed to apply version $TARGET_REF"
else
    git fetch -q --depth 1 origin "$BRANCH" || die "Failed to fetch repository"
    git reset --hard -q origin/"$BRANCH" || die "Failed to apply updates"
fi

# Initialize submodules
if [[ -f "$UPD_DIR/repo/.gitmodules" ]]; then
    info "Initializing all submodule..."
    # shellcheck source=/dev/null
    if [[ -f "$UPD_DIR/repo/scripts/lib/submodules.sh" ]]; then
        source "$UPD_DIR/repo/scripts/lib/submodules.sh"
    fi
    if declare -f prune_removed_submodules >/dev/null 2>&1; then
        prune_removed_submodules "$UPD_DIR/repo"
    else
        # The helper ships in the same commit and the sparse checkout always pulls scripts/, so
        # a missing lib means a damaged checkout - say so rather than keep a second copy of the
        # prune that can drift from the tested one.
        warn "scripts/lib/submodules.sh is missing; skipping the submodule prune."
    fi
    git -C "$UPD_DIR/repo" submodule sync --recursive >/dev/null 2>&1 || true
    git -C "$UPD_DIR/repo" submodule update --init --recursive --force >/dev/null 2>&1 || die "Failed to initialize all submodules"
fi

[[ -f "$UPD_DIR/repo/src/dots/starship.toml" ]] || die "Missing src/dots content after update"

# 2. System update via Polkit
echo "PROGRESS: 2/5: Running system update..."
echo
echo "---------------------------------------------"
echo "  Step 1 - System Updates"
echo "---------------------------------------------"
if command -v pacman >/dev/null; then
    info "Running system update via pacman..."
    sudo pacman -Syu --noconfirm || warn "System update was canceled or failed. Continuing with non-sudo parts..."
elif command -v dnf >/dev/null; then
    info "Running system update via dnf..."
    sudo dnf upgrade --refresh -y || warn "System update was canceled or failed. Continuing with non-sudo parts..."
elif command -v apt-get >/dev/null; then
    info "Running system update via apt..."
    sudo apt-get update && sudo apt-get upgrade -y || warn "System update was canceled or failed. Continuing with non-sudo parts..."
fi

# 3. 08-build-shell.sh handles GUI privilege escalation itself.
info "Executing build scripts (GUI prompts will appear if required)..."

export BUNDLE_DIR="$UPD_DIR/repo"

# Helpers come from the revision just checked out. A reverted target predating the helper
# leaves the call unavailable, which is harmless: the recorded revision stays as it was.
if [[ -f "$BUNDLE_DIR/scripts/lib/update-state.sh" ]]; then
    # shellcheck source=/dev/null
    source "$BUNDLE_DIR/scripts/lib/update-state.sh"
fi

# 4. Deploy Configs
echo "PROGRESS: 3/5: Deploying configuration files..."
echo
echo "---------------------------------------------"
echo "  Step 2 - Deploy Configs"
echo "---------------------------------------------"
if [[ "${CAELESTIA_SKIP_DEPLOY:-0}" == "1" ]]; then
    info "Skipping deploy-configs per user settings."
else
    run_stage 900 bash "$UPD_DIR/repo/scripts/03-deploy-configs.sh" || die "Config deployment failed or timed out."
fi
echo "PROGRESS: 3/5: Configuration files deployed."

# 5. Build Shell
echo "PROGRESS: 4/5: Building the Caelestia shell UI..."
echo
echo "---------------------------------------------"
echo "  Step 3 - Build Caelestia Shell UI"
echo "---------------------------------------------"
if [[ "${CAELESTIA_SKIP_BUILD:-0}" == "1" ]]; then
    info "Skipping build-shell per user settings."
else
    run_stage 3600 bash "$UPD_DIR/repo/scripts/08-build-shell.sh" || die "Shell build failed or timed out."

    # Fail fast on an incomplete QML install, or the shell dies at startup with 'module
    # "Caelestia.Config" is not installed'.
    QML_BASE="$HOME/.local/lib/qt6/qml"
    CONFIG_MODULE_DIR="$QML_BASE/Caelestia/Config"
    if [[ ! -f "$CONFIG_MODULE_DIR/qmldir" ]]; then
        die "Installed QML module metadata missing at $CONFIG_MODULE_DIR/qmldir"
    fi

    shopt -s nullglob
    CONFIG_PLUGIN_FILES=("$CONFIG_MODULE_DIR"/*.so)
    shopt -u nullglob
    if [[ ${#CONFIG_PLUGIN_FILES[@]} -eq 0 ]]; then
        die "Installed Caelestia.Config plugin library missing in $CONFIG_MODULE_DIR"
    fi
fi

# 6. Record which revision is actually installed.
#
# record_installed_revision() refuses under CAELESTIA_SKIP_BUILD=1: the checkout moved
# but the shell was deliberately not rebuilt, so the new revision would describe a state
# nobody can see (#651). The previous value stays, still naming the running shell.
# The "cli" source and the fetched $BRANCH are passed explicitly: the shadow clone
# sits on whatever branch git init picked, and records the deploy provenance
# (.update_source/.update_repo) that the ownership guard above keys off.
if record_installed_revision "$BUNDLE_DIR" "$HOME/.config/quickshell/caelestia" "cli" "$BRANCH"; then
    info "Saved commit hash: $(cat "$HOME/.config/quickshell/caelestia/.current_commit" 2>/dev/null || true)"
elif [[ "${CAELESTIA_SKIP_BUILD:-0}" == "1" ]]; then
    info "Shell build skipped; the recorded revision still describes the running shell."
fi

echo "PROGRESS: done: Update completed successfully"
echo
echo "---------------------------------------------"
echo "  Update Completed Successfully!"
echo "---------------------------------------------"
